APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=heysolanabackend
DB_USERNAME=root
DB_PASSWORD=

# OpenAI API Configuration (required for voice AI features)
OPENAI_API_KEY=your_openai_api_key_here

# ECAPA speaker verification microservice (python-speech-brain)
VOICE_AI_URL=http://127.0.0.1:8001
VOICE_AI_TIMEOUT=45
VOICE_AI_DEFAULT_THRESHOLD=0.8
VOICE_AI_SECONDARY_DEFAULT_THRESHOLD=0.74
VOICE_AI_COMMAND_THRESHOLD=0.28
VOICE_AI_COMMAND_SECONDARY_THRESHOLD=0.26
VOICE_STREAM_VERIFY_ENABLED=true
# Optional — must match python-speech-brain VOICE_AI_INTERNAL_KEY when set
# VOICE_AI_INTERNAL_KEY=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Deployment key for maintenance endpoints
DEPLOY_KEY=your_secure_deploy_key_here

# Kalshi Trade API proxy
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_TIMEOUT=15
KALSHI_SIGNATURE_PATH_PREFIX=/trade-api/v2

# Jupiter token metadata cache (used by mobile wallet token search)
JUPITER_API_KEY="db472fb9-7b8d-4d8f-a3ff-96f4855924b2"
JUPITER_TIMEOUT=10
JUPITER_TOKENS_CACHE_TTL=86400
JUPITER_TOKENS_TOP_CACHE_TTL=3600
JUPITER_TOKENS_SEARCH_CACHE_TTL=21600

# Jumia catalog scraper (Bright Data Superproxy) – see docs/SUPERPROXY.md
# Preferred Superproxy format (same as Node scrapers in SUPERPROXY.md):
# PROXY_URL=brd.superproxy.io:33335:your-zone-username:your-zone-password
# Or split:
# PROXY_HOST=brd.superproxy.io
# PROXY_PORT=33335
# PROXY_USERNAME=
# PROXY_PASSWORD=
# Optional override (full Guzzle URL): JUMIA_PROXY_URL=http://user:pass@host:port
# JUMIA_PROXY_VERIFY_SSL=false
# JUMIA_SCRAPE_TIMEOUT=20

# ---------------------------------------------------------------------------
# Railway (production) – set these in Railway dashboard Variables
# ---------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-app.up.railway.app
# Passkeys / WebAuthn (optional — defaults in config/passkey.php)
# PASSKEY_RP_ID=hey.yraytestings.com.ng
# PASSKEY_APPLE_TEAM_ID=HRN328485T
# PASSKEY_IOS_BUNDLE_ID=com.maskyray.heysolana
# PASSKEY_ANDROID_PACKAGE=com.maskyray.heysolana
# PASSKEY_ANDROID_SHA256_CERT=debug1,debug2,play_app_signing_sha256 (comma-separated, no spaces)
# Example: project debug + ~/.android/debug + Play App signing key certificate SHA-256

# LOG_CHANNEL=stderr
# LOG_STDERR_FORMATTER=\Monolog\Formatter\JsonFormatter
# DB_CONNECTION=mysql
# DB_URL=${{MySQL.DATABASE_URL}}
# QUEUE_CONNECTION=database
