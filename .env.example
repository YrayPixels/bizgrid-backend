APP_NAME=StoreHause
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=storehause
DB_USERNAME=root
DB_PASSWORD=

# OpenAI — required for AI storefront generation when provider=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o

# DeepSeek — required when provider=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-v4-pro

# Gemini, builder provider, and shopper/vision/marketing routing can all be set
# in platform admin → AI & storage. These env values are only the initial fallback.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.6-flash
# api_key (AI Studio prepaid) or vertex (Google Cloud billing / $300 credits, uses GCS service account)
GEMINI_AUTH=api_key
GEMINI_LOCATION=global
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_PROVIDER=openai

# Dealie AI Integration
DEALIE_API_URL=http://localhost:8000
# Generate one with: openssl rand -hex 32 (must match Dealie's DEALIE_INTEGRATION_SECRET)
DEALIE_INTEGRATION_SECRET=change_me_generate_with_openssl_rand_hex_32

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=
API_CACHE_ENABLED=true
API_CACHE_TTL=60

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
# Production: use smtp, ses, or resend — never leave this as `log` or merchants will not receive verification codes.
# Port 465 (SSL) => MAIL_SCHEME=smtps
# Port 587 (STARTTLS) => MAIL_SCHEME=smtp  (or leave null) and use submission port
MAIL_SCHEME=smtps
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
# Keep mail "From" name aligned with the brand used in templates. Use a real domain you control in production.
MAIL_FROM_NAME="${STOREHAUSE_BRAND_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google Cloud Storage — merchant / try-on uploads.
# Prefer Admin → AI & storage (includes a local vs GCS switch). These env vars are only a fallback.
# driver: local (public/) or gcs. Unset = GCS when a bucket + credentials exist, else local.
# GOOGLE_CLOUD_STORAGE_DRIVER=local
# Create a GCS bucket (public read, or a public prefix) and a service account with
# roles/storage.objectAdmin. Paste the JSON key in admin, or here / as a file path.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_STORAGE_PATH_PREFIX=bizgrid
# GOOGLE_CLOUD_STORAGE_PUBLIC_URL=https://storage.googleapis.com/your-bucket
# JSON contents of the service account key (preferred on cPanel / PaaS):
GOOGLE_CLOUD_CREDENTIALS=
# Or a path to the key file:
# GOOGLE_CLOUD_KEY_FILE=/path/to/service-account.json

VITE_APP_NAME="${APP_NAME}"

# Deployment key for maintenance endpoints
DEPLOY_KEY=your_secure_deploy_key_here

# Dodo Payments — merchant subscription billing
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_STARTER=
DODO_PRODUCT_GROWTH=
DODO_PRODUCT_SCALE=
STOREHAUSE_APP_URL=http://localhost:3000
# CORS defaults to * (required for www + storefront subdomains + custom domains).
# Do not set STOREHAUSE_CORS_ORIGINS in production — a partial list breaks login from www.
# STOREHAUSE_CORS_ORIGIN_PATTERNS=

# Google OAuth — merchant sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to {APP_URL}/api/storehause/auth/google/callback
# Local dev example: http://localhost:8000/api/storehause/auth/google/callback
# Merchant and admin Google sign-in both use this single redirect URI.
GOOGLE_REDIRECT_URI=
STOREHAUSE_PLATFORM_DOMAIN=bizgrid.shop
# Optional override for logo shown in platform emails (defaults to {STOREHAUSE_APP_URL}/bizgridlogo.png)
# STOREHAUSE_MAIL_LOGO_URL=
# STOREHAUSE_MAIL_PRIMARY_COLOR=#0d9488
STOREHAUSE_BRAND_NAME=Bizgrid
# Platform admin dashboard URL used in admin account emails
STOREHAUSE_ADMIN_APP_URL=http://localhost:5173
# Seeded platform admin credentials (used by database/seeders/AdminSeeder.php)
# Set a strong unique password before first deploy. Do not use defaults in production.
STOREHAUSE_ADMIN_EMAIL=admin@storehause.local
STOREHAUSE_ADMIN_PASSWORD=

# One-click demo merchant for judges/organizers (frontend /demo).
# When true, `php artisan db:seed` also runs DemoMerchantSeeder.
# STOREHAUSE_DEMO_LOGIN=true
# STOREHAUSE_DEMO_EMAIL=demo@bizgrid.shop
# STOREHAUSE_DEMO_NAME="Demo Merchant"
# STOREHAUSE_DEMO_PASSWORD=DemoBizgrid2026!
# CC this address on new merchant welcome emails (defaults to MAIL_FROM_ADDRESS)


# Paystack — platform collects customer checkout; merchants receive settlements
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# Facebook — merchant Page posting for Marketing Agent
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0
# Optional override; defaults to {APP_URL}/api/storehause/marketing/facebook/callback
FACEBOOK_REDIRECT_URI=

# WhatsApp Cloud API — customer AI auto-replies
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_PLATFORM_ACCESS_TOKEN=

# TikTok Business Messaging — inbound DM auto-replies only
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_API_BASE_URL=https://business-api.tiktok.com/open_api/v1.3
TIKTOK_REDIRECT_URI=
TIKTOK_WEBHOOK_SECRET=
TIKTOK_OAUTH_AUTHORIZE_URL=https://www.tiktok.com/v2/auth/authorize/
TIKTOK_CONTENT_API_BASE_URL=https://open.tiktokapis.com/v2
# Optional override; defaults to {APP_URL}/api/storehause/marketing/tiktok/creator/callback
TIKTOK_CONTENT_REDIRECT_URI=

# Dodo credit entitlements (purchased packs grant into these on payment)
DODO_CREDIT_SMS=
DODO_CREDIT_WHATSAPP=
DODO_CREDIT_AI=

# Dodo pack products (SMS, WhatsApp, AI credit top-ups)
DODO_PRODUCT_SMS_500=
DODO_PRODUCT_SMS_1000=
DODO_PRODUCT_SMS_2500=
DODO_PRODUCT_WHATSAPP_200=
DODO_PRODUCT_WHATSAPP_500=
DODO_PRODUCT_WHATSAPP_1000=
DODO_PRODUCT_AI_50=
DODO_PRODUCT_AI_200=
DODO_PRODUCT_AI_500=

# PerfectCorp YCE — virtual try-on (bag / clothes). Stub mode is on when API key is empty.
PERFECTCORP_API_KEY=
PERFECTCORP_BASE_URL=https://yce-api-01.makeupar.com
PERFECTCORP_STUB=true
PERFECTCORP_POLL_INTERVAL_SECONDS=3
PERFECTCORP_MAX_POLL_ATTEMPTS=40
PERFECTCORP_STUB_DELAY_SECONDS=4

# ---------------------------------------------------------------------------
# Railway (production) – set these in Railway dashboard Variables
# ---------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-app.up.railway.app
# LOG_CHANNEL=stderr
# DB_CONNECTION=mysql
# DB_URL=${{MySQL.DATABASE_URL}}
# QUEUE_CONNECTION=database
